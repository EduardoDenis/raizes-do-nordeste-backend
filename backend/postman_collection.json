{
  "info": {
    "name": "Raizes do Nordeste - API Back-End (Plano de Testes)",
    "description": "Colecao do Plano de Testes. Execute as pastas na ordem (1 a 5), ou rode a colecao inteira no Collection Runner/newman. Pre-requisitos: API em http://localhost:8080 e banco com o script.sql aplicado (unidade 1, produtos 1-3 e estoque). Os usuarios sao criados automaticamente (e-mails unicos) e os tokens JWT ficam em variaveis da colecao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "SETUP - Registrar GERENTE (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Gerente Teste\",\n  \"email\": \"{{emailGerente}}\",\n  \"senha\": \"Senha@123\",\n  \"perfil\": \"GERENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria um usuario GERENTE com e-mail unico a cada execucao. Rota publica."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailGerente\", \"gerente.\" + Date.now() + \"@teste.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 (usuario criado)\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SETUP - Registrar CLIENTE (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Teste\",\n  \"email\": \"{{emailCliente}}\",\n  \"senha\": \"Senha@123\",\n  \"perfil\": \"CLIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailCliente\", \"cliente.\" + Date.now() + \"@teste.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 (usuario criado)\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "T01 - Login valido GERENTE (200 + accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailGerente}}\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Retorna accessToken JWT\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"tokenGerente\", j.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "SETUP - Login CLIENTE (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "SETUP - Descobrir IDs dos usuarios (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenGerente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const lista = pm.response.json();",
                  "const g = lista.find(u => u.email === pm.collectionVariables.get(\"emailGerente\"));",
                  "const c = lista.find(u => u.email === pm.collectionVariables.get(\"emailCliente\"));",
                  "pm.test(\"Encontrou os usuarios criados\", function () { pm.expect(g).to.exist; pm.expect(c).to.exist; });",
                  "pm.test(\"Senha nao e exposta na resposta\", function () { pm.expect(g).to.not.have.property(\"senha\"); pm.expect(g).to.not.have.property(\"password\"); });",
                  "pm.collectionVariables.set(\"usuarioIdGerente\", g.id);",
                  "pm.collectionVariables.set(\"usuarioIdCliente\", c.id);"
                ]
              }
            }
          ]
        }
      ]
    },
