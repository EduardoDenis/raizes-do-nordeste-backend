    {
      "name": "3 - Pedidos",
      "item": [
        {
          "name": "T04 - Criar pedido valido no canal TOTEM (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"TOTEM\",\n  \"unidadeId\": {{unidadeId}},\n  \"usuarioId\": {{usuarioIdCliente}},\n  \"itens\": [\n    { \"produtoId\": {{produtoId}}, \"quantidade\": 2 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Seed: produto 2 (Tapioca Rendada) custa R$ 15,00 -> 2 unidades = R$ 30,00. Abate 2 unidades do estoque da unidade 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Pedido criado com canal e status corretos\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.canalPedido).to.eql(\"TOTEM\");",
                  "  pm.expect(j.status).to.eql(\"AGUARDANDO_PAGAMENTO\");",
                  "  pm.expect(Number(j.valorTotal)).to.eql(30);",
                  "  pm.collectionVariables.set(\"pedidoId\", j.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "T05 - Consultar pedido por ID (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Retorna o pedido criado\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"pedidoId\"))); });"
                ]
              }
            }
          ]
        }
      ]
